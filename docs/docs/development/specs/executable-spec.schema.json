{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZH-LAO Executable Spec artifacts",
  "description": "Scope-aware normative field contract. Deep structural and traceability validation is implemented by scripts/check_executable_specs.py.",
  "oneOf": [
    { "$ref": "#/$defs/registry" },
    { "$ref": "#/$defs/canonicalSpec" },
    { "$ref": "#/$defs/evidence" }
  ],
  "$defs": {
    "scopeType": { "enum": ["domain", "feature", "system"] },
    "scopeId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "reference": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string" },
        "kind": { "enum": ["markdown", "http", "public", "db", "event", "state_machine", "schema", "code", "test"] }
      },
      "additionalProperties": false
    },
    "registryEntry": {
      "type": "object",
      "required": ["scope_type", "scope_id"],
      "properties": {
        "scope_type": { "$ref": "#/$defs/scopeType" },
        "scope_id": { "$ref": "#/$defs/scopeId" }
      },
      "additionalProperties": false
    },
    "registry": {
      "type": "object",
      "required": ["schema_version", "adopted_scopes"],
      "properties": {
        "$schema": { "type": "string" },
        "schema_version": { "const": "1.1" },
        "adopted_scopes": { "type": "array", "items": { "$ref": "#/$defs/registryEntry" } }
      },
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "required": ["id", "status", "statement", "authority_refs", "use_case_ids", "contract_refs", "acceptance_scenario_ids", "state_machine_ids"],
      "properties": {
        "id": { "type": "string" },
        "status": { "enum": ["baseline", "frozen", "designing", "deferred", "superseded"] },
        "statement": { "type": "string", "minLength": 1 },
        "authority_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reference" } },
        "use_case_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "contract_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reference" } },
        "acceptance_scenario_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "state_machine_ids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "canonicalSpec": {
      "type": "object",
      "required": ["artifact_type", "schema_version", "scope_type", "scope_id", "requirements", "use_cases", "acceptance_scenarios", "state_machines"],
      "properties": {
        "artifact_type": { "const": "canonical_spec" },
        "schema_version": { "const": "1.1" },
        "scope_type": { "$ref": "#/$defs/scopeType" },
        "scope_id": { "$ref": "#/$defs/scopeId" },
        "requirements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/requirement" } },
        "use_cases": { "type": "array", "minItems": 1 },
        "acceptance_scenarios": { "type": "array", "minItems": 1 },
        "state_machines": { "type": "array" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["artifact_type", "schema_version", "scope_type", "scope_id", "source_spec", "source_spec_sha256", "requirements", "gate_checks"],
      "properties": {
        "artifact_type": { "const": "derived_evidence" },
        "schema_version": { "const": "1.1" },
        "scope_type": { "$ref": "#/$defs/scopeType" },
        "scope_id": { "$ref": "#/$defs/scopeId" },
        "source_spec": { "type": "string", "minLength": 1 },
        "source_spec_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "requirements": { "type": "array" },
        "gate_checks": { "type": "array" }
      },
      "additionalProperties": false
    }
  }
}
