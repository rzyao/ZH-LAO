# ZH-LAO V2 Mobile environment configuration
#
# EXPO_PUBLIC_* variables are inlined into the client bundle at build time.
# NEVER place server secrets, private keys or database credentials here.

# V2 Backend base URL. Required for native builds; there is intentionally no
# hardcoded developer-machine IP fallback anywhere in the app.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Application environment: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Enable verbose client logging. Never enabled in production builds.
EXPO_PUBLIC_LOG_LEVEL=debug

# Optional realtime endpoint. The Foundation only defines the RealtimeClient
# interface; no chat or domain protocol is implemented yet.
EXPO_PUBLIC_REALTIME_URL=
