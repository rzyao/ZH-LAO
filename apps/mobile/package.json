{
  "name": "@zh-lao/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "start": "expo start --port 18081",
    "android": "expo start --android --port 18081",
    "ios": "expo start --ios --port 18081",
    "web": "expo start --web --port 18081",
    "prebuild": "expo prebuild",
    "export:web": "expo export --platform web --output-dir dist-web",
    "export:android": "expo export --platform android --output-dir dist-android",
    "expo:config": "expo config --type public",
    "expo:doctor": "expo-doctor",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "maestro test e2e/flows",
    "audit:architecture": "node scripts/check-architecture.mjs",
    "audit:dependencies": "node scripts/check-dependencies.mjs",
    "audit:security": "node scripts/check-security.mjs",
    "audit:scope": "node scripts/check-scope.mjs",
    "audit": "pnpm audit:architecture && pnpm audit:dependencies && pnpm audit:security && pnpm audit:scope",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm audit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.14",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.37.0",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.87.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.19",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@expo/metro-runtime": "~6.1.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.35.0",
    "eslint-config-expo": "~10.0.0",
    "expo-doctor": "^1.20.4",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  }
}
