# ZH-LAO Admin — environment template
# All variables in a frontend build are public. NEVER put server secrets here.

# V2 backend API base URL. When empty, same-origin `/api` is used (see vite proxy).
VITE_API_BASE_URL=

# App environment label shown in the UI: development | test | production
VITE_APP_ENV=development

# Enable the internal design-system showcase route (/system/design-system)
VITE_ENABLE_DESIGN_SYSTEM=true
