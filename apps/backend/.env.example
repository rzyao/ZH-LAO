APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000
DATABASE_URL=postgresql://zh_lao:replace-me@127.0.0.1:5432/zh_lao
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
LOG_LEVEL=info
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
# 生产环境必须提供 >= 32 字符的随机密钥；缺少时服务启动会 fail fast。
# OTP_HMAC_SECRET=replace-with-random-secret-at-least-32-chars
# JWT_HMAC_SECRET=replace-with-random-secret-at-least-32-chars
