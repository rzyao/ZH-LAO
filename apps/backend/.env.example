APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=18080
DATABASE_URL=postgresql://zh_lao:replace-me@127.0.0.1:5432/zh_lao
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
LOG_LEVEL=info
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
# 生产环境必须提供 >= 32 字符的随机密钥；缺少时服务启动会 fail fast。
OTP_HMAC_SECRET=replace-with-random-secret-at-least-32-chars
JWT_HMAC_SECRET=replace-with-random-secret-at-least-32-chars
# OTP 投递 provider：默认 unavailable（未接真实 SMS 时 /phone-otp 失败安全 503，绝不 fake-success）。
# console 仅供 development 显式启用（生产环境禁止）。
# IDENTITY_OTP_PROVIDER=unavailable
# 首次启动自动初始化的后台超管账号（建议生产环境修改）。
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=123456

# ---- Platform Capability Providers（WP-04）----
# 每个能力独立选择 Provider；默认 unavailable/none = 能力 Port 存在但未接线，
# 调用失败安全（PROVIDER_UNAVAILABLE / no-op cache），绝不静默 fake-success。
# 'memory' / 'fake' 仅供 development/test；生产环境配置校验会直接拒绝。
# 生产真实 Provider 尚未冻结（不凭空绑定云厂商），未来在 schema 枚举中扩展。
# OBJECT_STORAGE_PROVIDER=unavailable
# TRANSLATION_PROVIDER=unavailable
# TTS_PROVIDER=unavailable
# MEDIA_PROCESSING_PROVIDER=unavailable
# Cache：缺省 development/test=memory、production=none（多实例禁止单进程 Map 当
# 共享状态；Redis 等共享缓存 Adapter 未在本 WP 捆绑上线，接入前显式设 none 或真实缓存）。
# CACHE_PROVIDER=none

